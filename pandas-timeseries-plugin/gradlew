#!/bin/sh

##############################################################################
# Gradle wrapper start-up script for POSIX-compatible shells
##############################################################################

# Resolve the script's real directory (follow symlinks)
app_path=$0
while [ -h "$app_path" ]; do
    ls=$(ls -ld "$app_path")
    link=$(expr "$ls" : '.*-> \(.*\)$')
    case $link in
        /*) app_path=$link ;;
        *)  app_path=$(dirname "$app_path")/$link ;;
    esac
done
APP_HOME=$(cd "$(dirname "$app_path")" && pwd)

APP_BASE_NAME=$(basename "$0")
CLASSPATH=$APP_HOME/gradle/wrapper/gradle-wrapper.jar

DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Locate java
if [ -n "$JAVA_HOME" ]; then
    JAVACMD="$JAVA_HOME/bin/java"
    if [ ! -x "$JAVACMD" ]; then
        echo "ERROR: JAVA_HOME points to an invalid directory: $JAVA_HOME" >&2
        exit 1
    fi
else
    JAVACMD=java
    if ! command -v java >/dev/null 2>&1; then
        echo "ERROR: JAVA_HOME is not set and 'java' was not found in PATH." >&2
        exit 1
    fi
fi

# Verify the wrapper jar exists
if [ ! -f "$CLASSPATH" ]; then
    echo "ERROR: gradle-wrapper.jar not found at $CLASSPATH" >&2
    echo "Run the following to download it:" >&2
    echo "  curl -sL https://services.gradle.org/distributions/gradle-8.7-bin.zip -o /tmp/g87.zip \\" >&2
    echo "    && unzip -p /tmp/g87.zip gradle-8.7/lib/plugins/gradle-wrapper-8.7.jar \\" >&2
    echo "       > gradle/wrapper/gradle-wrapper.jar \\" >&2
    echo "    && rm /tmp/g87.zip" >&2
    exit 1
fi

# Escape application args so they survive eval
save() {
    for i do
        printf '%s\n' "$i" | sed "s/'/'\\\\''/g;1s/^/'/;\$s/\$/' \\\\/"
    done
    echo " "
}
APP_ARGS=$(save "$@")

# eval strips the embedded quotes from DEFAULT_JVM_OPTS before handing
# arguments to the JVM (this is the standard Gradle wrapper technique).
eval set -- \
    $DEFAULT_JVM_OPTS \
    $JAVA_OPTS \
    $GRADLE_OPTS \
    "\"-Dorg.gradle.appname=$APP_BASE_NAME\"" \
    -classpath "\"$CLASSPATH\"" \
    org.gradle.wrapper.GradleWrapperMain \
    "$APP_ARGS"

exec "$JAVACMD" "$@"
